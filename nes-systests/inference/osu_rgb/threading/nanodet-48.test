GlobalConfiguration enable_event_trace: [true]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [500000]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]

CREATE LOGICAL SOURCE osuRgbSource(frameBase64 VARSIZED);
CREATE PHYSICAL SOURCE FOR osuRgbSource TYPE File;
ATTACH FILE large/osu_rgb/otcbvs_osu_rgb.csv

CREATE SINK osuRgbVarsizedDiscard(detectedObjects VARSIZED) TYPE Discard;

CREATE MODEL nanodet(
    PATH "TESTDATA/model/osu/pretrained/nanodet/nanodet.onnx"
    BACKEND OPENVINO
    INPUTS (VARSIZED)
    OUTPUTS (detectedObjects VARSIZED)
);

Configuration worker.query_engine.number_of_worker_threads: [48]
Configuration worker.default_query_execution.inference.openvino_inference_num_threads: [1]
SELECT detectedObjects FROM (
    SELECT INFER_MODEL(nanodet, (framePreprocessed))
    FROM (
        SELECT ResizeImage(FromBase64(frameBase64), INT32(320), INT32(320)) AS framePreprocessed
        FROM osuRgbSource
    )
)
INTO osuRgbVarsizedDiscard;
----

