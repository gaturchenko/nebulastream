# NanoDet-Plus with a ResNet-101 backbone instead of ShuffleNetV2 (16.2 vs 0.45 GMACs at 1x3x320x320, random weights), so that
# inference, not reading and parsing the frames, bounds the query on a 48-thread server; nanodet-24.test is the same sweep with
# the original model, whose queries are bound by the source.
GlobalConfiguration enable_event_trace: [true]
# One OpenVINO stream per worker-thread session, so that each split's inference_num_threads applies: with num_streams 0
# OpenVINO drops inference_num_threads and runs every inference on one core (x86).
GlobalConfiguration worker.default_query_execution.inference.openvino_num_streams: [1]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [500000]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]

CREATE LOGICAL SOURCE osuRgbSource(frameBase64 VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR osuRgbSource TYPE File;
ATTACH FILE large/osu_rgb/otcbvs_osu_rgb.csv

CREATE SINK osuRgbVarsizedDiscard(detectedObjects VARSIZED NOT NULL) TYPE Void;

CREATE MODEL nanodet ('model/osu/pretrained/nanodet/nanodet-plus-r101.onnx')
INPUT (framePreprocessed VARSIZED)
OUTPUT (detectedObjects VARSIZED);

Configuration worker.query_engine.number_of_worker_threads: [24]
Configuration worker.default_query_execution.inference.openvino_inference_num_threads: [1]
SELECT detectedObjects FROM MODEL_INFERENCE(nanodet, (
        SELECT FROM_BASE64(frameBase64) AS framePreprocessed
        FROM osuRgbSource
    )
)
INTO osuRgbVarsizedDiscard;
----

Configuration worker.query_engine.number_of_worker_threads: [12]
Configuration worker.default_query_execution.inference.openvino_inference_num_threads: [2]
SELECT detectedObjects FROM MODEL_INFERENCE(nanodet, (
        SELECT FROM_BASE64(frameBase64) AS framePreprocessed
        FROM osuRgbSource
