GlobalConfiguration enable_event_trace: [true]

CREATE LOGICAL SOURCE osuRgbSource(frameBase64 VARSIZED);
CREATE PHYSICAL SOURCE FOR osuRgbSource TYPE File;
ATTACH FILE large/osu_rgb/otcbvs_osu_rgb.csv

CREATE SINK osuRgbVarsizedDiscard(detectedObjects VARSIZED) TYPE Discard;

CREATE MODEL yoloV4Tiny(
    PATH "TESTDATA/model/osu/pretrained/yolov4/yolov4_tiny_26x26.onnx"
    INPUTS (VARSIZED)
    OUTPUTS (detectedObjects VARSIZED)
);

CREATE MODEL nanodet(
    PATH "TESTDATA/model/osu/pretrained/nanodet/nanodet.onnx"
    INPUTS (VARSIZED)
    OUTPUTS (detectedObjects VARSIZED)
);

CREATE MODEL yolo26n(
    PATH "TESTDATA/model/osu/pretrained/yolo26n/yolo26n.onnx"
    INPUTS (VARSIZED)
    OUTPUTS (detectedObjects VARSIZED)
);

Configuration worker.number_of_buffers_in_global_buffer_manager: [500000]
Configuration worker.default_query_execution.operator_buffer_size: [131072]
Configuration worker.default_query_execution.page_size: [16384]
Configuration worker.query_engine.number_of_worker_threads: [16]
SELECT detectedObjects FROM (
    SELECT INFER_MODEL(nanodet, (framePreprocessed))
    FROM (
        SELECT ResizeImage(FromBase64(frameBase64), INT32(320), INT32(320)) AS framePreprocessed
        FROM osuRgbSource
    )
)
INTO osuRgbVarsizedDiscard;
----

Configuration worker.number_of_buffers_in_global_buffer_manager: [500000]
Configuration worker.default_query_execution.operator_buffer_size: [131072]
Configuration worker.default_query_execution.page_size: [16384]
Configuration worker.query_engine.number_of_worker_threads: [16]
Configuration worker.default_query_execution.inference.prediction_cache_type: [SECOND_CHANCE]
Configuration worker.default_query_execution.inference.number_of_entries_prediction_cache: [128]
SELECT detectedObjects FROM (
    SELECT INFER_MODEL(yolo26n, (framePreprocessed))
    FROM (
        SELECT SSIM(FromBase64(frameBase64), FLOAT32(0.85)) AS framePreprocessed
        FROM osuRgbSource
    )
)
INTO osuRgbVarsizedDiscard;
----

Configuration worker.number_of_buffers_in_global_buffer_manager: [500000]
Configuration worker.default_query_execution.operator_buffer_size: [131072]
Configuration worker.default_query_execution.page_size: [16384]
Configuration worker.query_engine.number_of_worker_threads: [16]
Configuration worker.default_query_execution.inference.batch_size: 2
SELECT detectedObjects FROM (
    SELECT INFER_MODEL(yolo26n, (framePreprocessed))
    FROM (
        SELECT FromBase64(frameBase64) AS framePreprocessed
        FROM osuRgbSource
    )
)
INTO osuRgbVarsizedDiscard;
----
