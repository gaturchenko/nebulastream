# name: inference/InferModelCache.test
# description: ML model inference with prediction caching
# groups: [Inference]

SEQUENTIAL_EXECUTION

GlobalConfiguration worker.query_engine.number_of_worker_threads: [1]
GlobalConfiguration worker.default_query_execution.inference.openvino_inference_num_threads: [1]

CREATE LOGICAL SOURCE stream(p1 FLOAT32 NOT NULL, p2 FLOAT32 NOT NULL, p3 FLOAT32 NOT NULL, p4 FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
6.1,3.5,1.4,0.2
6.1,3.5,1.4,0.2
4.9,3.0,1.4,0.2
4.9,3.0,1.4,0.2
4.7,3.2,1.3,0.2
4.7,3.2,1.3,0.2
6.1,3.5,1.4,0.2
6.1,3.5,1.4,0.2
4.9,3.0,1.4,0.2
4.7,3.2,1.3,0.2
6.1,3.5,1.4,0.2
4.9,3.0,1.4,0.2
4.7,3.2,1.3,0.2
4.7,3.2,1.3,0.2
4.9,3.0,1.4,0.2
6.1,3.5,1.4,0.2

CREATE MODEL iris ('model/iris.onnx')
INPUT (p1 FLOAT32, p2 FLOAT32, p3 FLOAT32, p4 FLOAT32)
OUTPUT (setosa FLOAT32, versicolor FLOAT32, virginica FLOAT32);

CREATE SINK result(`STREAM$P1` FLOAT32 NOT NULL, `STREAM$P2` FLOAT32 NOT NULL, `STREAM$P3` FLOAT32 NOT NULL, `STREAM$P4` FLOAT32 NOT NULL, SETOSA FLOAT32 NOT NULL, VERSICOLOR FLOAT32 NOT NULL, VIRGINICA FLOAT32 NOT NULL) TYPE File;

Configuration worker.default_query_execution.inference.prediction_cache_type: [FIFO, LFU, LRU, SECOND_CHANCE]
Configuration worker.default_query_execution.inference.prediction_cache_scope: [THREAD_LOCAL, GLOBAL]
Configuration worker.default_query_execution.inference.number_of_entries_prediction_cache: [1, 2]
Configuration worker.default_query_execution.inference.use_batch_deduplication: [false, true]
SELECT * FROM MODEL_INFERENCE(iris, stream)
INTO result;
