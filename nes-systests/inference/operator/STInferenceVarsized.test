CREATE SINK solarPowerVarsizedChecksum(powerProdNext8Sec VARSIZED) TYPE Checksum;
CREATE SINK solarPowerVarsizedDiscard(powerProdNext8Sec VARSIZED) TYPE Discard;

CREATE MODEL dLinear(
    PATH "TESTDATA/model/solar_power/pretrained/dlinear/dlinear_solar_size_60_stride_4.onnx"
    INPUTS (VARSIZED)
    OUTPUTS (powerProdNext8Sec VARSIZED)
);

# We run single-threaded *Varsized tests to test correctness of the query output
# Multi-threaded tests do not produce deterministic results, since a number of first and last windows are not full
# If a window is not full, we overwrite only first N bytes of the thread-local byte buffer used as input for IREE
# If the thread had processed full windows before, the buffer will contain the bytes from previous inference calls
# If the thread had only processed non-full windows before, the buffer will be "zero-padded"
# This leads to non-deterministic inference results across different runs with multiple worker threads

Configuration worker.query_engine.number_of_worker_threads: [1]
SELECT powerProdNext8Sec FROM (
    SELECT INFER_MODEL(dLinear, (value_60_sec))
    FROM (
        SELECT ARRAY_AGG(value) AS value_60_sec
        FROM solarPowerSource
        WINDOW SLIDING(timestamp, SIZE 60000 ms, ADVANCE BY 20000 ms)
    )
) INTO solarPowerVarsizedChecksum;
----
11,644

SELECT powerProdNext8Sec FROM (
    SELECT INFER_MODEL(dLinear, (value_60_sec))
    FROM (
        SELECT ARRAY_AGG(value) AS value_60_sec
        FROM solarPowerSource
        WINDOW SLIDING(timestamp, SIZE 60000 ms, ADVANCE BY 20000 ms)
    )
) INTO solarPowerVarsizedDiscard;
