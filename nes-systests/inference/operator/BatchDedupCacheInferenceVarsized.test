# name: inference/operator/BatchCacheInferenceVarsized.test
# description: Batch inference operator with batch deduplication and prediction caching
# groups: [Inference, Operator, Varsized]

GlobalConfiguration worker.default_query_execution.operator_buffer_size: [190]
GlobalConfiguration worker.default_query_execution.inference.batch_size: [3]
GlobalConfiguration worker.default_query_execution.inference.number_of_entries_prediction_cache: [3]
GlobalConfiguration worker.default_query_execution.inference.use_batch_deduplication: [true]

CREATE LOGICAL SOURCE solarPowerSource(timestamp UINT64, value FLOAT32);
CREATE PHYSICAL SOURCE FOR solarPowerSource TYPE File;
ATTACH INLINE
