GlobalConfiguration enable_event_trace: [true]
GlobalConfiguration worker.query_engine.number_of_worker_threads: [2]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [524288]

CREATE LOGICAL SOURCE cwruSource(timestamp UINT64 NOT NULL, value FLOAT32 NOT NULL);
#CREATE PHYSICAL SOURCE FOR cwruSource TYPE File;
CREATE PHYSICAL SOURCE FOR cwruSource TYPE TCP SET(
    48000 AS `SOURCE`.MOCK_TUPLE_RATE
);
ATTACH FILE large/cwru_bearing/X229_FE_time.csv

CREATE SINK cwruVarsizedDiscardAnomaly(anomaly_score FLOAT32 NOT NULL) TYPE Void;

CREATE MODEL sarad ('model/cwru_bearing/pretrained/sarad/sarad-size-200-stride-10.onnx')
INPUT (value_200_ms VARSIZED)
OUTPUT (anomaly_score FLOAT32);

SELECT anomaly_score
FROM MODEL_INFERENCE(sarad, (
        SELECT ARRAY_AGG(value) AS value_200_ms
        FROM cwruSource
        WINDOW SLIDING(timestamp, SIZE 200 ms, ADVANCE BY 10 ms)
    )
)
INTO cwruVarsizedDiscardAnomaly;
----

SELECT anomaly_score
FROM MODEL_INFERENCE(sarad, (
        SELECT ARRAY_AGG(QUANTIZE(value, VARSIZED('uint8'))) AS value_200_ms
        FROM cwruSource
        WINDOW SLIDING(timestamp, SIZE 200 ms, ADVANCE BY 10 ms)
    )
)
INTO cwruVarsizedDiscardAnomaly;
----
