CREATE SINK snkCalVoid(f01 FLOAT32 NOT NULL) TYPE Void;
CREATE SINK snksCalHot0Fp32(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);
CREATE SINK snksCalHot0Int8(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);
CREATE SINK snksCalHot90Fp32(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);
CREATE SINK snksCalHot90Int8(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);

# :01 -- generator ceiling: no inference operator, 500000 records
SELECT f01 AS f01 FROM sCalHot0 INTO snkCalVoid;
----

# :02 -- rate=1000000000 tuples/s, structure=hotset, duplicates=0%, precision=fp32, records=500000
SELECT prediction, ingestion_time
FROM MODEL_INFERENCE(nbeats300, (
        SELECT
            f01,
            f02,
            f03,
            f04,
            f05,
            f06,
            f07,
            f08,
            f09,
            f10,
            f11,
            f12,
            f13,
            f14,
            f15,
            f16,
            f17,
            f18,
            f19,
            f20,
            f21,
            f22,
            f23,
            f24,
            f25,
            f26,
            f27,
            f28,
            f29,
            f30,
            f31,
            f32,
            f33,
            f34,
            f35,
            f36,
            f37,
            f38,
            f39,
            f40,
            f41,
            f42,
            f43,
            f44,
            f45,
            f46,
            f47,
            f48,
            f49,
            f50,
            f51,
            f52,
            f53,
            f54,
            f55,
            f56,
            f57,
            f58,
            f59,
            f60,
            f61,
            f62,
            f63,
            f64,
            f65,
            f66,
            f67,
            f68,
            f69,
            f70,
            f71,
            f72,
            f73,
            f74,
            f75,
            CURRENT_TIME() AS ingestion_time
        FROM sCalHot0
    )
)
INTO snksCalHot0Fp32;
----

