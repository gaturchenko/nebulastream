GlobalConfiguration enable_event_trace: [true]
GlobalConfiguration worker.query_engine.number_of_worker_threads: [24]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [524288]

CREATE LOGICAL SOURCE ecgSource(timestamp UINT64 NOT NULL, value FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR ecgSource TYPE File;
ATTACH FILE large/ptb-diagnostic-ecg/patient023-s0080lre.csv

CREATE SINK ecgVarsizedDiscard20ms(ecgNext20Ms VARSIZED NOT NULL) TYPE Void;

CREATE MODEL nBeats100ms ('model/ptb-diagnostic-ecg/pretrained/nbeats/nbeats_size_100_stride_10.onnx')
INPUT (value_100_ms VARSIZED)
OUTPUT (ecgNext20Ms VARSIZED);

SELECT ecgNext20Ms
FROM MODEL_INFERENCE(nBeats100ms, (
        SELECT ARRAY_AGG(value) AS value_100_ms
        FROM ecgSource
        WINDOW SLIDING(timestamp, SIZE 100 ms, ADVANCE BY 10 ms)
    )
)
INTO ecgVarsizedDiscard20ms;
----
