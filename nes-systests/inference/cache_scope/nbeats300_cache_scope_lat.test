       'CACHE_HOTSET FLOAT32 1000000 95 64 1 0, CACHE_HOTSET FLOAT32 1000000 95 64 1 1, CACHE_HOTSET FLOAT32 1000000 95 64 1 2, CACHE_HOTSET FLOAT32 1000000 95 64 1 3, CACHE_HOTSET FLOAT32 1000000 95 64 1 4, CACHE_HOTSET FLOAT32 1000000 95 64 1 5, CACHE_HOTSET FLOAT32 1000000 95 64 1 6, CACHE_HOTSET FLOAT32 1000000 95 64 1 7, CACHE_HOTSET FLOAT32 1000000 95 64 1 8, CACHE_HOTSET FLOAT32 1000000 95 64 1 9, CACHE_HOTSET FLOAT32 1000000 95 64 1 10, CACHE_HOTSET FLOAT32 1000000 95 64 1 11, CACHE_HOTSET FLOAT32 1000000 95 64 1 12, CACHE_HOTSET FLOAT32 1000000 95 64 1 13, CACHE_HOTSET FLOAT32 1000000 95 64 1 14, CACHE_HOTSET FLOAT32 1000000 95 64 1 15, CACHE_HOTSET FLOAT32 1000000 95 64 1 16, CACHE_HOTSET FLOAT32 1000000 95 64 1 17, CACHE_HOTSET FLOAT32 1000000 95 64 1 18, CACHE_HOTSET FLOAT32 1000000 95 64 1 19, CACHE_HOTSET FLOAT32 1000000 95 64 1 20, CACHE_HOTSET FLOAT32 1000000 95 64 1 21, CACHE_HOTSET FLOAT32 1000000 95 64 1 22, CACHE_HOTSET FLOAT32 1000000 95 64 1 23, CACHE_HOTSET FLOAT32 1000000 95 64 1 24, CACHE_HOTSET FLOAT32 1000000 95 64 1 25, CACHE_HOTSET FLOAT32 1000000 95 64 1 26, CACHE_HOTSET FLOAT32 1000000 95 64 1 27, CACHE_HOTSET FLOAT32 1000000 95 64 1 28, CACHE_HOTSET FLOAT32 1000000 95 64 1 29, CACHE_HOTSET FLOAT32 1000000 95 64 1 30, CACHE_HOTSET FLOAT32 1000000 95 64 1 31, CACHE_HOTSET FLOAT32 1000000 95 64 1 32, CACHE_HOTSET FLOAT32 1000000 95 64 1 33, CACHE_HOTSET FLOAT32 1000000 95 64 1 34, CACHE_HOTSET FLOAT32 1000000 95 64 1 35, CACHE_HOTSET FLOAT32 1000000 95 64 1 36, CACHE_HOTSET FLOAT32 1000000 95 64 1 37, CACHE_HOTSET FLOAT32 1000000 95 64 1 38, CACHE_HOTSET FLOAT32 1000000 95 64 1 39, CACHE_HOTSET FLOAT32 1000000 95 64 1 40, CACHE_HOTSET FLOAT32 1000000 95 64 1 41, CACHE_HOTSET FLOAT32 1000000 95 64 1 42, CACHE_HOTSET FLOAT32 1000000 95 64 1 43, CACHE_HOTSET FLOAT32 1000000 95 64 1 44, CACHE_HOTSET FLOAT32 1000000 95 64 1 45, CACHE_HOTSET FLOAT32 1000000 95 64 1 46, CACHE_HOTSET FLOAT32 1000000 95 64 1 47, CACHE_HOTSET FLOAT32 1000000 95 64 1 48, CACHE_HOTSET FLOAT32 1000000 95 64 1 49, CACHE_HOTSET FLOAT32 1000000 95 64 1 50, CACHE_HOTSET FLOAT32 1000000 95 64 1 51, CACHE_HOTSET FLOAT32 1000000 95 64 1 52, CACHE_HOTSET FLOAT32 1000000 95 64 1 53, CACHE_HOTSET FLOAT32 1000000 95 64 1 54, CACHE_HOTSET FLOAT32 1000000 95 64 1 55, CACHE_HOTSET FLOAT32 1000000 95 64 1 56, CACHE_HOTSET FLOAT32 1000000 95 64 1 57, CACHE_HOTSET FLOAT32 1000000 95 64 1 58, CACHE_HOTSET FLOAT32 1000000 95 64 1 59, CACHE_HOTSET FLOAT32 1000000 95 64 1 60, CACHE_HOTSET FLOAT32 1000000 95 64 1 61, CACHE_HOTSET FLOAT32 1000000 95 64 1 62, CACHE_HOTSET FLOAT32 1000000 95 64 1 63, CACHE_HOTSET FLOAT32 1000000 95 64 1 64, CACHE_HOTSET FLOAT32 1000000 95 64 1 65, CACHE_HOTSET FLOAT32 1000000 95 64 1 66, CACHE_HOTSET FLOAT32 1000000 95 64 1 67, CACHE_HOTSET FLOAT32 1000000 95 64 1 68, CACHE_HOTSET FLOAT32 1000000 95 64 1 69, CACHE_HOTSET FLOAT32 1000000 95 64 1 70, CACHE_HOTSET FLOAT32 1000000 95 64 1 71, CACHE_HOTSET FLOAT32 1000000 95 64 1 72, CACHE_HOTSET FLOAT32 1000000 95 64 1 73, CACHE_HOTSET FLOAT32 1000000 95 64 1 74' AS `SOURCE`.GENERATOR_SCHEMA
);

CREATE MODEL nbeats300 ('model/power/pretrained/nbeats/nbeats_size_300_stride_30.onnx')
INPUT (f01 FLOAT32, f02 FLOAT32, f03 FLOAT32, f04 FLOAT32, f05 FLOAT32, f06 FLOAT32, f07 FLOAT32, f08 FLOAT32, f09 FLOAT32, f10 FLOAT32, f11 FLOAT32, f12 FLOAT32, f13 FLOAT32, f14 FLOAT32, f15 FLOAT32, f16 FLOAT32, f17 FLOAT32, f18 FLOAT32, f19 FLOAT32, f20 FLOAT32, f21 FLOAT32, f22 FLOAT32, f23 FLOAT32, f24 FLOAT32, f25 FLOAT32, f26 FLOAT32, f27 FLOAT32, f28 FLOAT32, f29 FLOAT32, f30 FLOAT32, f31 FLOAT32, f32 FLOAT32, f33 FLOAT32, f34 FLOAT32, f35 FLOAT32, f36 FLOAT32, f37 FLOAT32, f38 FLOAT32, f39 FLOAT32, f40 FLOAT32, f41 FLOAT32, f42 FLOAT32, f43 FLOAT32, f44 FLOAT32, f45 FLOAT32, f46 FLOAT32, f47 FLOAT32, f48 FLOAT32, f49 FLOAT32, f50 FLOAT32, f51 FLOAT32, f52 FLOAT32, f53 FLOAT32, f54 FLOAT32, f55 FLOAT32, f56 FLOAT32, f57 FLOAT32, f58 FLOAT32, f59 FLOAT32, f60 FLOAT32, f61 FLOAT32, f62 FLOAT32, f63 FLOAT32, f64 FLOAT32, f65 FLOAT32, f66 FLOAT32, f67 FLOAT32, f68 FLOAT32, f69 FLOAT32, f70 FLOAT32, f71 FLOAT32, f72 FLOAT32, f73 FLOAT32, f74 FLOAT32, f75 FLOAT32)
OUTPUT (prediction VARSIZED);

CREATE SINK nbeatsLatencyH25(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);
CREATE SINK nbeatsLatencyH50(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);
CREATE SINK nbeatsLatencyH75(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);
CREATE SINK nbeatsLatencyH95(prediction VARSIZED NOT NULL, ingestion_time UINT64 NOT NULL) TYPE Latency SET(
       'results/latency_timings.csv' AS `SINK`.log_path,
       'ingestion_time' AS `SINK`.ingest_field
);

