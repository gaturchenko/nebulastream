GlobalConfiguration enable_event_trace: [true]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [500000]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]

CREATE LOGICAL SOURCE solarPowerSource(timestamp UINT64, value FLOAT64);
CREATE PHYSICAL SOURCE FOR solarPowerSource TYPE File;
ATTACH FILE large/solar_power/solar-power.csv

CREATE SINK solarPowerVarsizedDiscard(powerProdNext2Min VARSIZED) TYPE Discard;

CREATE MODEL dLinear(
    PATH "TESTDATA/model/solar_power/pretrained/dlinear/dlinear_solar_size_600_stride_60.onnx"
    INPUTS (VARSIZED)
    OUTPUTS (powerProdNext2Min VARSIZED)
);

Configuration worker.query_engine.number_of_worker_threads: [4]
SELECT powerProdNext2Min FROM (
    SELECT INFER_MODEL(dLinear, (value_10_min))
    FROM (
        SELECT ARRAY_AGG(value) AS value_10_min
        FROM solarPowerSource
        WINDOW SLIDING(timestamp, SIZE 600000 ms, ADVANCE BY 60000 ms)
    )
) INTO solarPowerVarsizedDiscard;
----

Configuration worker.query_engine.number_of_worker_threads: [8]
