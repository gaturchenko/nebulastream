GlobalConfiguration enable_event_trace: [true]
GlobalConfiguration worker.query_engine.number_of_worker_threads: [24]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [524288]

CREATE LOGICAL SOURCE solarPowerSource(timestamp UINT64 NOT NULL, value FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR solarPowerSource TYPE File;
ATTACH FILE large/solar_power/solar-power.csv

CREATE SINK solarPowerVarsizedDiscard2min(powerProdNext2Min VARSIZED NOT NULL) TYPE Void;
CREATE SINK solarPowerVarsizedDiscard1min(powerProdNext1Min VARSIZED NOT NULL) TYPE Void;
CREATE SINK solarPowerVarsizedDiscard24sec(powerProdNext24Sec VARSIZED NOT NULL) TYPE Void;

CREATE MODEL nBeats10min ('model/power/pretrained/nbeats/nbeats_size_600_stride_60.onnx')
INPUT (value_10_min VARSIZED)
OUTPUT (powerProdNext2Min VARSIZED);

CREATE MODEL nBeats5min ('model/power/pretrained/nbeats/nbeats_size_300_stride_30.onnx')
INPUT (value_5_min VARSIZED)
OUTPUT (powerProdNext1Min VARSIZED);

CREATE MODEL nBeats2min ('model/power/pretrained/nbeats/nbeats_size_120_stride_12.onnx')
INPUT (value_2_min VARSIZED)
OUTPUT (powerProdNext24sec VARSIZED);

SELECT powerProdNext2Min
FROM MODEL_INFERENCE(nBeats10min, (
        SELECT ARRAY_AGG(value) AS value_10_min
        FROM solarPowerSource
        WINDOW SLIDING(timestamp, SIZE 600000 ms, ADVANCE BY 60000 ms)
    )
)
INTO solarPowerVarsizedDiscard2min;
----

SELECT NBEATS_SIZE_600_STRIDE_60_UDF(value_10_min) AS powerProdNext2Min
FROM (
    SELECT ARRAY_AGG(value) AS value_10_min
    FROM solarPowerSource
    WINDOW SLIDING(timestamp, SIZE 600000 ms, ADVANCE BY 60000 ms)
)
INTO solarPowerVarsizedDiscard2min;
----

SELECT powerProdNext1Min
FROM MODEL_INFERENCE(nBeats5min,(
        SELECT ARRAY_AGG(value) AS value_5_min
        FROM solarPowerSource
        WINDOW SLIDING(timestamp, SIZE 300000 ms, ADVANCE BY 30000 ms)
    )
)
INTO solarPowerVarsizedDiscard1min;
----

SELECT NBEATS_SIZE_300_STRIDE_30_UDF(value_5_min) AS powerProdNext1Min
FROM (
    SELECT ARRAY_AGG(value) AS value_5_min
    FROM solarPowerSource
    WINDOW SLIDING(timestamp, SIZE 300000 ms, ADVANCE BY 30000 ms)
)
INTO solarPowerVarsizedDiscard1min;
----

Configuration worker.default_query_execution.operator_buffer_size: [32768]
Configuration worker.default_query_execution.page_size: [4096]
Configuration worker.number_of_buffers_in_global_buffer_manager: [1000000]
SELECT powerProdNext24Sec
FROM MODEL_INFERENCE(nBeats2min, (
        SELECT ARRAY_AGG(value) AS value_2_min
        FROM solarPowerSource
        WINDOW SLIDING(timestamp, SIZE 120000 ms, ADVANCE BY 12000 ms)
    )
)
INTO solarPowerVarsizedDiscard24sec;
----

SELECT NBEATS_SIZE_120_STRIDE_12_UDF(value_2_min) AS powerProdNext24Sec
FROM (
    SELECT ARRAY_AGG(value) AS value_2_min
    FROM solarPowerSource
    WINDOW SLIDING(timestamp, SIZE 120000 ms, ADVANCE BY 12000 ms)
)
INTO solarPowerVarsizedDiscard24sec;
----
