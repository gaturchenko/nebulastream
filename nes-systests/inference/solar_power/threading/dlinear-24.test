GlobalConfiguration enable_event_trace: [true]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [500000]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]

CREATE LOGICAL SOURCE solarPowerSource(timestamp UINT64 NOT NULL, value FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR solarPowerSource TYPE File;
ATTACH FILE large/solar_power/solar-power.csv

CREATE SINK solarPowerVarsizedDiscard2min(powerProdNext2Min VARSIZED NOT NULL) TYPE Void;

CREATE MODEL dlinear ('model/solar_power/pretrained/dlinear/dlinear_solar_size_600_stride_60.onnx')
INPUT (value_10_min VARSIZED)
OUTPUT (powerProdNext2Min VARSIZED);

Configuration worker.query_engine.number_of_worker_threads: [24]
Configuration worker.default_query_execution.inference.openvino_inference_num_threads: [1]
SELECT powerProdNext2Min FROM MODEL_INFERENCE(dlinear, (
        SELECT ARRAY_AGG(value) AS value_10_min
        FROM solarPowerSource
        WINDOW SLIDING(timestamp, SIZE 600000 ms, ADVANCE BY 60000 ms)
    )
)
INTO solarPowerVarsizedDiscard2min;
----

Configuration worker.query_engine.number_of_worker_threads: [12]
Configuration worker.default_query_execution.inference.openvino_inference_num_threads: [2]
