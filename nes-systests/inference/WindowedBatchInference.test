CREATE MODEL iris ('model/iris.onnx')
INPUT (p1 FLOAT32, p2 FLOAT32, p3 FLOAT32, p4 FLOAT32)
OUTPUT (setosa FLOAT32, versicolor FLOAT32, virginica FLOAT32);

CREATE SINK result(SETOSA FLOAT32 NOT NULL, VERSICOLOR FLOAT32 NOT NULL, VIRGINICA FLOAT32 NOT NULL) TYPE File;

SELECT setosa, versicolor, virginica
FROM MODEL_INFERENCE(iris, (
    SELECT MAX(p1) AS p1, MAX(p2) AS p2, MAX(p3) AS p3, MAX(p4) AS p4
    FROM irisStream
    WINDOW SLIDING(ts, SIZE 4 SEC, ADVANCE BY 1 SEC)
))
INTO result;
