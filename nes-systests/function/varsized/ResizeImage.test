# name: function/varsized/ResizeImage.test
# description: Dedicated tests for ResizeImage varsized function
# groups: [Function, Varsized]

CREATE LOGICAL SOURCE imageStream(encoded VARSIZED);
CREATE PHYSICAL SOURCE FOR imageStream TYPE File;
ATTACH INLINE
iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAACklEQVR42mNoAAAAggCB2kUIOwAAAABJRU5ErkJggg==

CREATE SINK resizeSink(resized VARSIZED) TYPE File;

# Resize a 1x1 grayscale PNG to 2x2 and verify deterministic output.
SELECT ToBase64(ResizeImage(FromBase64(encoded), UINT32(2), UINT32(2))) AS resized
FROM imageStream INTO resizeSink;
----
iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAAAAABX3VL4AAAADklEQVQIHWNsYGBsYAAAA48BA7PgjjkAAAAASUVORK5CYII=

# A non-positive target width triggers passthrough.
SELECT ToBase64(ResizeImage(FromBase64(encoded), UINT32(0), UINT32(2))) AS resized
FROM imageStream INTO resizeSink;
----
iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAACklEQVR42mNoAAAAggCB2kUIOwAAAABJRU5ErkJggg==
