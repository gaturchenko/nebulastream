CREATE SINK sinkStream(stream.start UINT64 NOT NULL, stream.end UINT64 NOT NULL, stream.text VARSIZED NOT NULL) TYPE File;

SELECT start, end, ARRAY_AGG(character) AS text
FROM stream WINDOW TUMBLING(ts, size 10 ms) INTO sinkStream;
----
0,10,HelloWorld
10,20,HelloWorld
20,30,HelloWorld
