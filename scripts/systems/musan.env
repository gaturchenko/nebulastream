# MUSAN audio / MHATT-RNN keyword spotting, single audio stream.
#
# Must stay in sync with queries/musan/systems.test:
#   ARRAY_AGG over SLIDING(SIZE 1 sec, ADVANCE 333 ms) at MOCK_TUPLE_RATE 16000
#     <-> 16000 samples per window / 5328 per advance <-> GEOMETRY_JSON samples
#         and WINDOW_SAMPLES / ADVANCE_SAMPLES / RATE defaults in the Flink runner
#   number_of_worker_threads 2 <-> PARALLELISM default in the Flink runner
#
# The model is a TensorFlow SavedModel. MODEL_SOURCE is the directory (OpenVINO reads it with its
# own TF frontend, no TensorFlow install involved); TorchServe serves the resulting IR, because the
# Keras RNN layers cannot be exported to ONNX -- see the handler's module docstring. All three
# systems therefore execute the same graph. The IR's .bin must travel into the .mar beside the .xml.
WORKLOAD=musan

MODEL_SOURCE=/home/gaturchenko/navi/models-benchmarking/models/mhatt-rnn/saved_model
MODEL_IR=/home/gaturchenko/navi/models-benchmarking/models/mhatt-rnn/saved_model.xml

TS_MODEL_NAME=mhatt_rnn
TS_HANDLER=scripts/torchserve/mhatt_rnn_handler.py
TS_SERIALIZED=/home/gaturchenko/navi/models-benchmarking/models/mhatt-rnn/saved_model.xml
TS_EXTRA_FILES=/home/gaturchenko/navi/models-benchmarking/models/mhatt-rnn/saved_model.bin
GEOMETRY_JSON='{"samples": 16000}'

TEST_FILE=musan/systems.test
DATA_DIR=./datasets/musan
# Separate from the ablation yamls in the same directory, which other scripts own.
ST_CONFIG=queries/musan/systems_st.yaml
UDF_CONFIG=queries/musan/systems_udf.yaml

FLINK_RUN=baselines/flink-openvino-baseline/scripts/run-pi-musan-mhatt.sh
