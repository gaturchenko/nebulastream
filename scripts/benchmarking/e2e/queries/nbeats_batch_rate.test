#  Source-rate x batch-size micro-benchmark on the Pi (N-BEATS, window-fed batched inference).
#
#  Inference fed by a time window lowers to InterBufferBatchingPhysicalOperator, which waits for B
#  window results before invoking the model (no timeout). A batch therefore costs (B - 1) strides of
#  fill time, while a too-small batch cannot amortise the per-invocation overhead at high arrival
#  rates -- the trade-off OPTIMIZER_CHOOSES resolves from the worker's model profile.
#
#  Synthetic series (gen_batch_rate_data.py): one sample every 4 ms of event time, so SIZE 300 ms is
#  exactly the 75 values nbeats_size_300_stride_30.onnx consumes.
#
#    :01 profiling -- File source, SIZE 300 ms / ADVANCE 1 ms. Only there to make OPTIMIZER_CHOOSES
#                     profile every power-of-two batch size up to inference_max_batch_size (the fill
#                     bound admits up to 300 / 1 = 300). Read the "Batch size ..." lines in the log.

GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [4096]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [4096]

CREATE LOGICAL SOURCE seriesProfile(timestamp UINT64 NOT NULL, value FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR seriesProfile TYPE File;
ATTACH FILE /home/gaturchenko/navi/datasets/synthetic/batch_rate_profile.csv

CREATE SINK forecastVoid(forecast VARSIZED NOT NULL) TYPE Void;

CREATE MODEL nbeats300 ('/home/gaturchenko/navi/models-benchmarking/models/nbeats/nbeats_size_300_stride_30.onnx')
INPUT (value_300_ms VARSIZED)
OUTPUT (forecast VARSIZED);

# Profiling
SELECT forecast
FROM MODEL_INFERENCE(nbeats300, (
        SELECT ARRAY_AGG(value) AS value_300_ms
        FROM seriesProfile
        WINDOW SLIDING(timestamp, SIZE 300 ms, ADVANCE BY 1 ms)
    )
)
INTO forecastVoid;
----
