GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [8192]

CREATE LOGICAL SOURCE series(timestamp UINT64 NOT NULL, value FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR series TYPE TCP SET(
    48000 AS `SOURCE`.MOCK_TUPLE_RATE,
    1 AS `SOURCE`.FLUSH_INTERVAL_MS
);
ATTACH FILE /home/gaturchenko/navi/datasets/synthetic/sensitivity_sarad.csv

CREATE SINK latencySink(
    anomaly_score VARSIZED NOT NULL,
    ingestion_time UINT64 NOT NULL
) TYPE LATENCY SET (
    'results/sensitivity/sarad/latency_timings.csv' AS `SINK`.log_path,
    'ingestion_time' AS `SINK`.ingest_field
);

CREATE MODEL sarad ('/home/gaturchenko/navi/models-benchmarking/models/sarad/sarad_medium.onnx')
INPUT (value_200_ms VARSIZED)
OUTPUT (anomaly_score VARSIZED);

# ADVANCE 20 ms
SELECT anomaly_score, ingestion_time
FROM MODEL_INFERENCE(sarad, (
        SELECT ARRAY_AGG(value) AS value_200_ms, MAX(ingestion_time) AS ingestion_time
        FROM (SELECT timestamp, value, CURRENT_TIME() AS ingestion_time FROM series)
        WINDOW SLIDING(timestamp, SIZE 200 ms, ADVANCE BY 20 ms)
    )
)
INTO latencySink;
----

