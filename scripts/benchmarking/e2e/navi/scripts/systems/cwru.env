# CWRU bearing vibration / SARAD anomaly detection.
#
# Must stay in sync with queries/cwru-bearing/systems.test:
#   ARRAY_AGG over SLIDING(SIZE 200 ms, ADVANCE 100 ms) at MOCK_TUPLE_RATE 48000
#     <-> 9600 samples per window / 4800 per advance <-> GEOMETRY_JSON samples
#         and WINDOW_SAMPLES / ADVANCE_SAMPLES / RATE defaults in the Flink runner
#   number_of_worker_threads 3 <-> PARALLELISM default in the Flink runner
#
# TorchServe serves the same ONNX file NES loads, through onnxruntime (as SqueezeDet does).
WORKLOAD=cwru

MODEL_SOURCE=/home/gaturchenko/navi/models-benchmarking/models/sarad/sarad_medium.onnx
MODEL_IR=/home/gaturchenko/navi/models-benchmarking/models/sarad/sarad_medium.xml

TS_MODEL_NAME=sarad
TS_HANDLER=scripts/torchserve/sarad_handler.py
TS_SERIALIZED=/home/gaturchenko/navi/models-benchmarking/models/sarad/sarad_medium.onnx
GEOMETRY_JSON='{"samples": 9600}'

TEST_FILE=cwru-bearing/systems.test
DATA_DIR=./datasets/cwru-bearing
# Separate from the ablation yamls in the same directory, which other scripts own.
ST_CONFIG=queries/cwru-bearing/systems_st.yaml
UDF_CONFIG=queries/cwru-bearing/systems_udf.yaml

FLINK_RUN=baselines/flink-openvino-baseline/scripts/run-pi-cwru-sarad.sh
