# Waymo / SqueezeDet object detection -- the published framework comparison.
#
# Must stay in sync with queries/waymo/systems.test:
#   RESIZE_IMAGE(..., 120, 80) <-> GEOMETRY_JSON width/height
#   MOCK_TUPLE_RATE 10         <-> RATE default in the Flink runner
#   number_of_worker_threads 2 <-> PARALLELISM default in the Flink runner
WORKLOAD=waymo

MODEL_SOURCE=/home/gaturchenko/navi/models-benchmarking/models/squeezedet/squeezedet.onnx
MODEL_IR=/home/gaturchenko/navi/models-benchmarking/models/squeezedet/squeezedet.xml

TS_MODEL_NAME=squeezedet
TS_HANDLER=scripts/torchserve/squeezedet_handler.py
TS_SERIALIZED=/home/gaturchenko/navi/models-benchmarking/models/squeezedet/squeezedet.onnx
GEOMETRY_JSON='{"width": 80, "height": 120}'

TEST_FILE=waymo/systems.test
DATA_DIR=./datasets/waymo
# Separate from the ablation yamls in the same directory, which other scripts own.
ST_CONFIG=queries/waymo/systems_st.yaml
UDF_CONFIG=queries/waymo/systems_udf.yaml

FLINK_RUN=baselines/flink-openvino-baseline/scripts/run-pi-waymo-squeezedet.sh
