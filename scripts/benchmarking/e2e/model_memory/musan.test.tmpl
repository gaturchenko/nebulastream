#  Model memory on the Pi (revision §8): MUSAN speech with MHAtt-RNN, as in the systems comparison.
#
#    :01 baseline -- the same source and sliding window, no model
#    :02 MHAtt-RNN
#
#  10 s of the 16 kHz recording; the buffer settings are those of the MUSAN systems test, with a pool of 256 buffers, small
#  enough to be in use within the first second (see waymo.test.tmpl).

GlobalConfiguration worker.query_engine.number_of_worker_threads: [4]
GlobalConfiguration worker.default_query_execution.inference.openvino_num_streams: [1]
GlobalConfiguration worker.default_query_execution.inference.openvino_inference_num_threads: [4]
GlobalConfiguration worker.default_query_execution.inference.prediction_cache_type: [NONE]
GlobalConfiguration worker.default_query_execution.inference.use_batch_deduplication: [false]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [131072]
GlobalConfiguration worker.default_query_execution.page_size: [16384]
GlobalConfiguration worker.default_max_inflight_buffers: [16]
GlobalConfiguration worker.number_of_buffers_in_global_buffer_manager: [256]

CREATE LOGICAL SOURCE musanSource(timestamp UINT64 NOT NULL, audioSample INT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR musanSource TYPE TCP SET(
    16000 AS `SOURCE`.MOCK_TUPLE_RATE
);
ATTACH FILE @ROOT@/datasets/model_memory/musan.csv

CREATE SINK musanWindowsVoid(payload VARSIZED NOT NULL) TYPE Void;
CREATE SINK musanKeywordsVoid(keywordProb VARSIZED NOT NULL) TYPE Void;

CREATE MODEL mhatt_rnn ('@ROOT@/models-benchmarking/models/mhatt-rnn/saved_model')
INPUT (audio1sec VARSIZED)
OUTPUT (keywordProb VARSIZED);

# baseline
SELECT audio1sec AS payload
FROM (
    SELECT ARRAY_AGG(audioSample / FLOAT32(32767.0)) AS audio1sec
    FROM musanSource
    WINDOW SLIDING(timestamp, SIZE 1 sec, ADVANCE BY 333 ms)
)
INTO musanWindowsVoid;
----

# MHAtt-RNN
SELECT keywordProb
FROM MODEL_INFERENCE(mhatt_rnn, (
        SELECT ARRAY_AGG(audioSample / FLOAT32(32767.0)) AS audio1sec
        FROM musanSource
        WINDOW SLIDING(timestamp, SIZE 1 sec, ADVANCE BY 333 ms)
    )
)
INTO musanKeywordsVoid;
----
